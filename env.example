# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3050
APP_BASE_URL=https://tiquet.v79sl.duckdns.org
ALLOWED_ORIGINS=https://tiquet.v79sl.duckdns.org
# ── PostgreSQL Database (Primary Production Database) ─────────────────────────
# Connected to the tiquet-postgres container.
# Generate DB_PASSWORD with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_HOST=tiquet-postgres
DB_PORT=5432
DB_NAME=tiquet
DB_USER=tiquet_app
DB_PASSWORD=
# Or provide a single connection string:
# DATABASE_URL=postgresql://tiquet_app:password@tiquet-postgres:5432/tiquet

# ── SQLite Legacy Path (for initial one-time migration and backup) ─────────────
DATABASE_PATH=/app/data/tiquet.db

# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SUPER_ADMIN_JWT_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Optional OAuth (email+password works without these; only needed if you
#    want "Sign in with Google/Apple" as well) ───────────────────────────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Email — required for 2FA-adjacent flows (invites, password resets,
#    status notifications). Recommended: Resend or Postmark transactional
#    email over raw SMTP for deliverability; both support SMTP submission
#    too, so this works with either. ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="V79 Tiquet <no-reply@yourdomain.com>"

# ── Public intake (website2026 contact form → Tiquet job) ───────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match TIQUET_INTAKE_SECRET in website2026's environment exactly.
INTAKE_SECRET=
INTAKE_ACCOUNT_ID=default_account

# ── FFPRO2 Gateway (job marked PAID → income in Fire Finance Pro) ───────────
# When a job is marked PAID, this account's own account_id is sent to FFPRO2
# as the "Workspace Number" — the same value shown to admins in Settings so
# it can be pasted into FFPRO2 → Settings → Gateway. No separate config is
# needed here for "which workspace"; every account already has one.
# If unset, this integration is simply inactive (no error, no retries) —
# most deployments won't have it configured.
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match TIQUET_GATEWAY_SECRET in FFPRO2's environment exactly.
FFPRO_GATEWAY_URL=
FFPRO_GATEWAY_SECRET=

# ── Billing (OFF unless set — see server/stripe.js; currently simulated,
#    not wired into the UI, and intentionally not started in production
#    without a real key so no fake checkout endpoint is ever reachable) ─────
STRIPE_SECRET_KEY=
PLAN_PRICE_STARTER=
PLAN_PRICE_PRO=
PLAN_PRICE_ENTERPRISE=
TRIAL_DAYS=14
