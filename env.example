# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
APP_BASE_URL=https://tiquet.v79sl.duckdns.org
ALLOWED_ORIGINS=https://tiquet.v79sl.duckdns.org
DATABASE_PATH=/app/data/tiquet.db
# Leave false in production. When true, seeds sample demo data on first boot
# (useful only for local testing).
SEED_DEMO_DATA=false

# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SUPER_ADMIN_JWT_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Optional OAuth (email+password works without these; only needed if you
#    want "Sign in with Google/Apple" as well) ───────────────────────────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Email — required for 2FA-adjacent flows (invites, password resets,
#    status notifications). Recommended: Resend or Postmark transactional
#    email over raw SMTP for deliverability; both support SMTP submission
#    too, so this works with either. ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="V79 Tiquet <no-reply@yourdomain.com>"

# ── Public intake (website2026 contact form → Tiquet job) ───────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match TIQUET_INTAKE_SECRET in website2026's environment exactly.
INTAKE_SECRET=
INTAKE_ACCOUNT_ID=default_account

# ── Billing (OFF unless set — see server/stripe.js; currently simulated,
#    not wired into the UI, and intentionally not started in production
#    without a real key so no fake checkout endpoint is ever reachable) ─────
STRIPE_SECRET_KEY=
PLAN_PRICE_STARTER=
PLAN_PRICE_PRO=
PLAN_PRICE_ENTERPRISE=
TRIAL_DAYS=14
