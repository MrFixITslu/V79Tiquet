ALLOWED_ORIGINS=
APPLE_CLIENT_ID=
APP_BASE_URL=
COMPANY_WEBSITE_URL=
DATABASE_PATH=
DATABASE_URL=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=
DB_USER=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FFPRO_GATEWAY_SECRET=
FFPRO_GATEWAY_URL=
GOOGLE_CLIENT_ID=
INTAKE_ACCOUNT_ID=
INTAKE_SECRET=
JWT_SECRET=
# Optional dedicated key for AES-256-GCM encryption of sensitive secrets. Use 32+ random characters in production.
TIQUET_DATA_ENCRYPTION_KEY=
PLAN_PRICE_ENTERPRISE=
PLAN_PRICE_PRO=
PLAN_PRICE_STARTER=
SEED_DEMO_DATA=
SMTP_FROM=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_USER=
STRIPE_SECRET_KEY=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_JWT_SECRET=
SUPER_ADMIN_PASSWORD=
TRIAL_DAYS=

# Shared HMAC secret used only for signed read-only V79 Hub service calls (32+ chars).
V79_PLATFORM_SHARED_SECRET=


# Phase 2 V79 Hub event publisher. Use the Tiquet-specific Hub secret.
V79_HUB_EVENT_URL=http://v79-hub:3040/api/platform/events
V79_HUB_EVENT_SECRET=
# Ecosystem v2 events: Hub must enable V79_ECOSYSTEM_V2_EVENTS_ENABLED=1
# and configure V79_TIQUET_EVENT_SECRET to exactly this dedicated value.
# Unmapped accounts are held in the local outbox, never sent as Hub org IDs.


# V79 Hub managed customer access.
V79_HUB_PUBLIC_URL=https://hub.v79sl.com
V79_HUB_INTERNAL_URL=http://v79-hub:3040
# Dedicated Tiquet -> Hub billing service secret (32+ characters).
V79_HUB_BILLING_URL=http://v79-hub:3040
V79_TIQUET_BILLING_SECRET=
V79_TIQUET_LAUNCH_SECRET=
V79_ALLOW_LEGACY_AUTH=0

# One-time migration switch: when enabled, a Hub owner may link an existing
# unlinked Tiquet Admin account with the same email. Keep disabled normally.
V79_ALLOW_EMAIL_ACCOUNT_LINK=0

# Hub is the commercial source of truth. Keep 1 in production.
V79_HUB_MANAGED_BILLING=1

# Opt-in: only enable after the matching Hub signed entitlement endpoint is deployed and tested.
V79_ENTITLEMENT_RECHECK_ENABLED=0

# Ecosystem v2: customer enquiry acknowledgement mail (OFF by default).
# Requires verified SMTP credentials and an explicit SMTP_FROM sender.
# Acknowledgement includes the V79 ticket reference only, never a portal token.
# delivery=requires_review or sending after a crash must be reconciled manually;
# never automatically replay uncertain SMTP results.
V79_ECOSYSTEM_V2_INTAKE_ACK_ENABLED=0

# Ecosystem v2 customer cancellation: OFF until staged finance/portal tests.
# Cancellation only before invoicing with no recorded payments; it revokes the
# customer portal link, preserves the service audit and never issues refunds.
V79_ECOSYSTEM_V2_CANCEL_ENABLED=0

# V2 invoice-link sending — OFF until two-tenant SMTP and idempotency tests.
# Only the matching Vision79 owner workspace is allowed a copy recipient.
# Set the FULL account ID from Tiquet Settings → Integrations. The recipient
# must be a verified corporate mailbox; never copy other customer tenants.
V79_ECOSYSTEM_V2_INVOICE_SEND_ENABLED=0
V79_TIQUET_INVOICE_CC_ACCOUNT_ID=
V79_TIQUET_INVOICE_CC_EMAIL=

# Client feedback on the portal remains OFF until staged privacy review.
V79_ECOSYSTEM_V2_FEEDBACK_ENABLED=0

# V2 signed event outbox stays queued until the Hub receiver is staged.
V79_ECOSYSTEM_V2_EVENT_DELIVERY=0
# New website enquiries are never auto-merged with unverified customer data.
V79_ECOSYSTEM_V2_STRICT_INTAKE_IDENTITY=0

# Stage only after real customer acceptance and payment-order race tests.
# A paid invoice does not prove delivery was accepted.
V79_ECOSYSTEM_V2_DELIVERY_ACCEPTANCE_REQUIRED=0

# V2 scope evidence: OFF until privacy, file containment, portal and
# backup/restore acceptance on the real staging host.
# The acknowledgement is not a legally certified e-signature.
V79_ECOSYSTEM_V2_SCOPE_ENABLED=0

# V2 event evidence / manual retry controls (OFF until staged security QA).
# This never directly replays email, payments or inventory movements.
V79_ECOSYSTEM_V2_EVENT_ADMIN_ENABLED=0
