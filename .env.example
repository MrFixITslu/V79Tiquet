# Shared HMAC secret used only for signed read-only V79 Hub service calls (32+ chars).
V79_PLATFORM_SHARED_SECRET=


# Phase 2 V79 Hub event publisher. Use the Tiquet-specific Hub secret.
V79_HUB_EVENT_URL=http://v79-hub:3040/api/platform/events
V79_HUB_EVENT_SECRET=


# V79 Hub managed customer access.
V79_HUB_PUBLIC_URL=https://hub.v79sl.com
V79_HUB_INTERNAL_URL=http://v79-hub:3040
V79_TIQUET_LAUNCH_SECRET=
V79_ALLOW_LEGACY_AUTH=0

# One-time migration switch: when enabled, a Hub owner may link an existing
# unlinked Tiquet Admin account with the same email. Keep disabled normally.
V79_ALLOW_EMAIL_ACCOUNT_LINK=0

# Hub is the commercial source of truth. Keep 1 in production.
V79_HUB_MANAGED_BILLING=1
